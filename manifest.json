{
  "manifest_version": 3,
  "name": "Lioden Hoard Organizer",
  "version": "1.0.3",
  "description": "Organize your Lioden hoard items into custom folders with aggregated views, instant search, and drag-and-drop sorting.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.lioden.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Lioden Hoard Organizer"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.lioden.com/hoard.php*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "emojis.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "lioden-hoard-organizer@rio-codes",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
